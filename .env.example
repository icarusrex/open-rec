# Copy to .env and fill in. Never commit .env.

# --- Postgres (shared by the VTN and open-rec, separate databases) ---------
PG_USER=openadr
PG_PASSWORD=change-me
PG_PORT=5432

# --- VTN (openleadr-rs) ---------------------------------------------------
VTN_PORT=3000
# URL the VTN advertises for its token endpoint (as seen by clients)
VTN_PUBLIC_URL=http://localhost:3000
# At least 32 bytes, base64. Generate with: openssl rand -base64 32
OAUTH_BASE64_SECRET=

# --- open-rec service (OpenADR business logic) -----------------------------
VTN_URL=http://vtn:3000
VTN_BL_CLIENT_ID=open-rec-bl
VTN_BL_CLIENT_SECRET=
VTN_PROGRAM_NAME=open-rec-surplus
OPENREC_DATABASE_URL=postgresql://openadr:change-me@db:5432/openrec

# PV site (defaults: 2.7 kWp, inverter capped at 3 kW)
SITE_LAT=39.9
SITE_LON=-8.6
PV_KWP=2.7
PV_TILT=30
# Open-Meteo convention: 0 = south, -90 = east, 90 = west
PV_AZIMUTH=0
PV_MAX_KW=3.0
PV_PERFORMANCE_RATIO=0.85

# Event logic
SURPLUS_THRESHOLD_KW=1.0
BASELOAD_KW_DEFAULT=0.3
MIN_WINDOW_QUARTERS=2
# Also open windows when the OMIE price is <= 0. Only useful on a dynamic
# (wholesale-indexed) tariff; on a fixed tariff it just buys grid power.
NEGATIVE_PRICE_WINDOWS=false
# Local (Lisbon) time to publish tomorrow's event; OMIE publishes ~13:00 CET
PUBLISH_TIME_LOCAL=14:30

# Test plan: paired steer/control days start on this date (empty = always steer)
TEST_PLAN_START=
TEST_PLAN_SEED=open-rec

# --- Home Assistant -------------------------------------------------------
HA_URL=http://homeassistant.local:8123
# Long-lived access token (HA profile > Security)
HA_TOKEN=
# Cumulative kWh counters (total_increasing sensors)
HA_PV_ENERGY_ENTITY=sensor.inverter_total_yield
HA_HOUSE_ENERGY_ENTITY=sensor.house_energy_total
# Optional: kWh counter of the steered load itself (the Shelly 1PM's energy sensor),
# so steering doesn't inflate the baseload estimate
HA_STEERED_ENERGY_ENTITY=sensor.water_heater_energy
# Helper the VEN bridge switches on during surplus windows
HA_WINDOW_ENTITY=input_boolean.open_rec_surplus_window

# --- VEN bridge (one per home) -------------------------------------------
VEN_CLIENT_ID=open-rec-ven-1
VEN_CLIENT_SECRET=
VEN_NAME=home-1
